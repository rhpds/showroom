apiVersion: k8s.ovn.org/v1
kind: EgressFirewall
metadata:
  name: default
  namespace: {{ _showroom_namespace }}
spec:
  egress:
{% if ocp4_workload_showroom_egress_allow_cluster_api | bool %}
    # Kubernetes API, for `oc` in the Showroom terminal. One rule covers both
    # paths: the in-cluster kubernetes.default ClusterIP DNATs to the
    # control-plane node addresses on 6443, and the external API VIP is held
    # by a control-plane node.
    #
    # A dnsName or dig-resolved /32 of the API hostname does NOT work here --
    # it only reaches the API VIP, never the in-cluster ClusterIP that the
    # terminal's in-pod kubeconfig uses.
    - type: Allow
      to:
        nodeSelector:
          matchLabels:
            node-role.kubernetes.io/control-plane: ""
      ports:
        - protocol: TCP
          port: 6443
{% endif %}
{% if ocp4_workload_showroom_egress_allow_cluster_routes | bool %}
    # Cluster Routes, for lab steps that curl an application's own Route or
    # clone from Gitea. Every Route resolves to the shared ingress VIP, so
    # this cannot be narrowed to one tenant's Routes.
    - type: Allow
      to:
        nodeSelector: {}
      ports:
        - protocol: TCP
          port: 443
{% endif %}
    - type: Allow
      to:
        dnsName: {{ ocp4_workload_showroom_content_git_repo | urlsplit('hostname') }}
{% set _zt_host = ocp4_workload_showroom_zero_touch_bundle | default('') | urlsplit('hostname') %}
{% if _zt_host %}
    - type: Allow
      to:
        dnsName: {{ _zt_host }}
{% if _zt_host == 'github.com' %}
    - type: Allow
      to:
        dnsName: objects.githubusercontent.com
{% endif %}
{% endif %}
{% set _ui_host = ocp4_workload_showroom_content_antora_ui_bundle_url | default('') | urlsplit('hostname') %}
{% if _ui_host %}
    - type: Allow
      to:
        dnsName: {{ _ui_host }}
{% endif %}
{% for domain in ocp4_workload_showroom_egress_allow_domains %}
    - type: Allow
      to:
        dnsName: {{ domain }}
{% endfor %}
{% for cidr in ocp4_workload_showroom_egress_allow_cidrs %}
    - type: Allow
      to:
        cidrSelector: {{ cidr }}
{% endfor %}
    - type: Deny
      to:
        cidrSelector: 0.0.0.0/0
    - type: Deny
      to:
        cidrSelector: ::/0
